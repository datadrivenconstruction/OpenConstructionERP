{
  "name": "openestimate-frontend",
  "private": true,
  "version": "16.7.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "node --max-old-space-size=9216 ./node_modules/typescript/bin/tsc -b && npm run typecheck:e2e && node --max-old-space-size=9216 ./node_modules/vite/bin/vite.js build",
    "preview": "vite preview",
    "test": "vitest",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:headed": "playwright test --headed",
    "test:e2e:smoke": "playwright test smoke/",
    "test:e2e:report": "playwright show-report qa-report",
    "test:e2e:install": "playwright install chromium firefox webkit --with-deps",
    "test:e2e:verify-projects": "playwright test --list --reporter=./tests/e2e/reporters/project-coverage.ts",
    "lint": "eslint .",
    "lint:tailwind": "node scripts/check_tailwind_conflicts.cjs",
    "lint:rtl": "node scripts/check_rtl_side_collapse.cjs",
    "lint:unicode": "node -e \"const{execFileSync}=require('child_process');const py=process.platform==='win32'?'python':'python3';try{execFileSync(py,['scripts/check_zero_width.py','frontend/src'],{cwd:'..',stdio:'inherit'})}catch(e){process.exit(e.status||1)}\"",
    "typecheck": "node --max-old-space-size=9216 ./node_modules/typescript/bin/tsc --noEmit && npm run typecheck:e2e",
    "typecheck:e2e": "node --max-old-space-size=9216 ./node_modules/typescript/bin/tsc --noEmit -p tsconfig.e2e.json && node --max-old-space-size=9216 ./node_modules/typescript/bin/tsc --noEmit -p tsconfig.e2e-root.json && node --max-old-space-size=9216 ./node_modules/typescript/bin/tsc --noEmit -p tsconfig.configs.json",
    "api:generate": "openapi-typescript http://localhost:8000/api/openapi.json -o src/shared/lib/api-types.ts"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^8.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@tanstack/react-query": "^5.101.2",
    "@types/three": "^0.185.0",
    "@xyflow/react": "^12.11.1",
    "ag-grid-community": "^32.3.0",
    "ag-grid-react": "^32.3.9",
    "cesium": "^1.142.0",
    "clsx": "^2.1.1",
    "date-fns": "^4.4.0",
    "exceljs": "^4.4.0",
    "i18next": "^24.2.3",
    "isomorphic-dompurify": "^3.18.0",
    "jspdf": "^4.2.1",
    "jspdf-autotable": "^5.0.8",
    "lucide-react": "^0.460.0",
    "maplibre-gl": "^5.24.0",
    "pdfjs-dist": "^4.10.38",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-i18next": "^15.7.4",
    "react-map-gl": "^8.1.1",
    "react-resizable-panels": "^4.12.0",
    "react-router-dom": "^7.18.2",
    "recharts": "^3.9.0",
    "three": "^0.185.0",
    "three-mesh-bvh": "^0.9.11",
    "y-webrtc": "^10.3.0",
    "y-websocket": "^3.0.0",
    "yjs": "^13.6.31",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.12.1",
    "@playwright/test": "^1.61.1",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/jest-axe": "^3.5.9",
    "@types/react": "^18.3.28",
    "@types/react-dom": "^18.3.7",
    "@typescript-eslint/eslint-plugin": "^8.62.0",
    "@typescript-eslint/parser": "^8.62.0",
    "@vitejs/plugin-react": "^4.7.0",
    "autoprefixer": "^10.5.2",
    "eslint": "^9.39.4",
    "jest-axe": "^10.0.0",
    "jsdom": "^29.1.1",
    "msw": "^2.14.6",
    "openapi-typescript": "^7.13.0",
    "postcss": "^8.5.16",
    "rollup-plugin-visualizer": "^7.0.1",
    "tailwindcss": "^3.4.19",
    "typescript": "^5.9.3",
    "vite": "^6.4.3",
    "vite-plugin-pwa": "^1.3.0",
    "vitest": "^4.1.9",
    "workbox-build": "^7.4.1",
    "workbox-window": "^7.4.1"
  },
  "overrides": {
    "dompurify": "^3.4.10",
    "protobufjs": "^8.6.0",
    "tmp": "^0.2.7",
    "rollup": "4.59.0",
    "undici": "^7.28.0",
    "ws": "^8.20.2",
    "js-yaml": "^4.2.0",
    "vite": "^6.4.3",
    "@babel/core": "^7.29.6",
    "exceljs": {
      "uuid": "^11.1.1"
    },
    "minimatch@>=10": {
      "brace-expansion": "^5.0.9"
    }
  }
}
