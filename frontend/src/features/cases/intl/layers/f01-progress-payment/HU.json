    "retentionTerm": "visszatartas",
    "payDoc": "szamla",
    "clockRegime": "the Ptk. payment rules",
    "clockStart": "the day the szamla is received",
    "payDays": "30",
    "escalationRoute": "take it to the Teljesitesigazolasi Szakertoi Szerv and preserve the claim"
  },
