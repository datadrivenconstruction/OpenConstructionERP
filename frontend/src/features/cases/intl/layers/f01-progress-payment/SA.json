    "certifier": "Engineer",
    "excessTerm": "variation order",
    "retentionTerm": "retention",
    "payDoc": "invoice",
    "clockRegime": "the government procurement payment rules",
    "clockStart": "the day the invoice is submitted against the issued certificate",
    "payDays": "30",
    "escalationRoute": "raise it with the contracting authority and refer it to the committee the law names"
