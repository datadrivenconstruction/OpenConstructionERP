"""Scaffold Hire data access."""

# Generated by the OpenConstructionERP module builder from a module
# specification. Edits are kept: the builder never overwrites a module it
# did not just create. To change the shape, change the spec and generate
# a new version.
# This file is the exception: when a newer builder fixes the code it
# renders here, it renders it again from spec.json at startup. The copy it
# replaces is kept under _module_builder/backups in the module folder.

import uuid
from collections.abc import Collection

from sqlalchemy import func, select
from sqlalchemy.ext.asyncio import AsyncSession

from app.modules.scaffold_hire.models import Hire


class HireRepository:
    """Reads and writes for oe_scaffold_hire_hire."""

    def __init__(self, session: AsyncSession) -> None:
        self.session = session

    async def list_page(
        self,
        project_id: uuid.UUID | None = None,
        within: Collection[uuid.UUID] | None = None,
        limit: int = 100,
        offset: int = 0,
    ) -> tuple[list[Hire], int]:
        """One page, plus the total the page was taken from.

        The total is counted rather than inferred from the page length, so a
        caller can tell a short last page from an empty result.

        ``within`` is the set of projects the caller may reach. ``None``
        means unrestricted, which the router only passes for an
        administrator; an empty set returns nothing rather than everything.
        Both filters apply before counting, so the total never counts rows
        the caller cannot see.
        """
        stmt = select(Hire)
        if project_id is not None:
            stmt = stmt.where(Hire.project_id == project_id)
        if within is not None:
            stmt = stmt.where(Hire.project_id.in_(list(within)))
        count_stmt = select(func.count()).select_from(stmt.subquery())
        total = int((await self.session.execute(count_stmt)).scalar_one())
        stmt = stmt.order_by(Hire.created_at.desc()).limit(limit).offset(offset)
        rows = list((await self.session.execute(stmt)).scalars().all())
        return rows, total

    async def get(self, record_id: uuid.UUID) -> Hire | None:
        return await self.session.get(Hire, record_id)

    async def add(self, record: Hire) -> Hire:
        self.session.add(record)
        await self.session.flush()
        return record

    async def delete(self, record: Hire) -> None:
        await self.session.delete(record)
        await self.session.flush()
