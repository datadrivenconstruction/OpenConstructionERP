"""Tests for Scaffold Hire."""

# Generated by the OpenConstructionERP module builder from a module
# specification. Edits are kept: the builder never overwrites a module it
# did not just create. To change the shape, change the spec and generate
# a new version.

from datetime import UTC, datetime, timedelta  # noqa: F401
from types import SimpleNamespace

from app.modules.scaffold_hire.validators import validate

RULES = [{'code': 'REFERENCE_REQUIRED', 'message': 'A hire needs a reference to be found by.', 'kind': 'required', 'field': 'reference', 'min_value': None, 'max_value': None, 'other_field': '', 'severity': 'error'}, {'code': 'RATE_POSITIVE', 'message': 'A weekly rate must be above zero.', 'kind': 'positive', 'field': 'weekly_rate', 'min_value': None, 'max_value': None, 'other_field': '', 'severity': 'error'}, {'code': 'BAYS_IN_RANGE', 'message': 'A hire covers between 1 and 500 bays.', 'kind': 'range', 'field': 'bay_count', 'min_value': 1.0, 'max_value': 500.0, 'other_field': '', 'severity': 'error'}, {'code': 'STATUS_KNOWN', 'message': 'Status must be one the register recognises.', 'kind': 'one_of', 'field': 'status', 'min_value': None, 'max_value': None, 'other_field': '', 'severity': 'error'}, {'code': 'INSPECTION_NOT_FUTURE', 'message': 'An inspection cannot be recorded before it happens.', 'kind': 'not_future', 'field': 'inspected_at', 'min_value': None, 'max_value': None, 'other_field': '', 'severity': 'error'}, {'code': 'OFF_HIRE_AFTER_ON_HIRE', 'message': 'Off hire cannot precede on hire.', 'kind': 'order', 'field': 'on_hire_date', 'min_value': None, 'max_value': None, 'other_field': 'off_hire_date', 'severity': 'error'}]


def _sound() -> SimpleNamespace:
    """A record every rule accepts."""
    return SimpleNamespace(reference='Reference', notes='About notes', bay_count=1, area_m2=1, weekly_rate=1, on_hire_date=(datetime.now(UTC) - timedelta(days=2)).date(), off_hire_date=(datetime.now(UTC) - timedelta(days=2)).date(), inspected_at=datetime.now(UTC) - timedelta(days=2), is_tagged=True, status='erected')


def _breaking(code: str) -> SimpleNamespace:
    """A sound record with exactly one rule broken."""
    record = _sound()
    rule = next(r for r in RULES if r["code"] == code)
    field, kind = rule["field"], rule["kind"]
    if kind == "required":
        setattr(record, field, None)
    elif kind in {"positive"}:
        setattr(record, field, -1)
    elif kind == "range":
        low, high = rule.get("min_value"), rule.get("max_value")
        setattr(record, field, (low - 1) if low is not None else (high + 1))
    elif kind == "one_of":
        setattr(record, field, "definitely-not-an-option")
    elif kind == "not_future":
        # No local import here. Binding datetime names inside one branch makes
        # them local to the whole function, and the order branch below then
        # raises UnboundLocalError on a name the module already imported.
        current = getattr(record, field)
        ahead = datetime.now(UTC) + timedelta(days=365)
        setattr(record, field, ahead if isinstance(current, datetime) else ahead.date())
    elif kind == "order":
        # One day past the field it must not exceed.
        setattr(record, field, getattr(record, rule["other_field"]) + timedelta(days=1))
    return record


class TestRules:
    def test_a_sound_record_passes_every_rule(self) -> None:
        assert validate(_sound()) == []

    def test_reference_required_fires(self) -> None:
        findings = validate(_breaking('REFERENCE_REQUIRED'))
        assert 'REFERENCE_REQUIRED' in [f.code for f in findings]

    def test_rate_positive_fires(self) -> None:
        findings = validate(_breaking('RATE_POSITIVE'))
        assert 'RATE_POSITIVE' in [f.code for f in findings]

    def test_bays_in_range_fires(self) -> None:
        findings = validate(_breaking('BAYS_IN_RANGE'))
        assert 'BAYS_IN_RANGE' in [f.code for f in findings]

    def test_status_known_fires(self) -> None:
        findings = validate(_breaking('STATUS_KNOWN'))
        assert 'STATUS_KNOWN' in [f.code for f in findings]

    def test_inspection_not_future_fires(self) -> None:
        findings = validate(_breaking('INSPECTION_NOT_FUTURE'))
        assert 'INSPECTION_NOT_FUTURE' in [f.code for f in findings]

    def test_off_hire_after_on_hire_fires(self) -> None:
        findings = validate(_breaking('OFF_HIRE_AFTER_ON_HIRE'))
        assert 'OFF_HIRE_AFTER_ON_HIRE' in [f.code for f in findings]

    def test_every_rule_is_covered(self) -> None:
        """The count is the point: a rule with no test looks the same as one that passes."""
        tested = {name.removeprefix("test_").removesuffix("_fires").upper() for name in dir(TestRules) if name.endswith("_fires")}
        assert tested == {r["code"] for r in RULES}
