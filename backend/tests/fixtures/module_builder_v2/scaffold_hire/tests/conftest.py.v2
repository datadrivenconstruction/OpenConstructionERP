"""Make this module importable when its tests run on their own."""

# Generated by the OpenConstructionERP module builder from a module
# specification. Edits are kept: the builder never overwrites a module it
# did not just create. To change the shape, change the spec and generate
# a new version.

from pathlib import Path

# tests/ -> <module>/ -> the runtime module root that holds it.
RUNTIME_ROOT = Path(__file__).resolve().parents[2]


def pytest_configure() -> None:
    from app.core.module_runtime_root import attach_runtime_root

    attach_runtime_root(RUNTIME_ROOT, create=False)
