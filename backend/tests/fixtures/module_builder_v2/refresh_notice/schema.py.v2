"""Physical table for Site Notice.

Table:
    oe_refresh_notice_notice

A generated module is installed outside the repository and therefore outside
Alembic's history, so it creates its own table rather than carrying a revision
that would collide with the platform's head on the next upgrade. Creation is
scoped to this one table and checked first, which makes it safe to call on
every start.

The scoping goes through ``Table.create`` and ``Table.drop`` rather than
``MetaData.create_all(tables=[...])``. The ``tables`` argument filters tables
and nothing else: standalone sequences declared anywhere on the shared
metadata are still visited, so dropping this module's table that way would
take a sequence belonging to another module with it.
"""

# Generated by the OpenConstructionERP module builder from a module
# specification. Edits are kept: the builder never overwrites a module it
# did not just create. To change the shape, change the spec and generate
# a new version.

from typing import Any

from sqlalchemy import Table

from app.modules.refresh_notice.models import Notice


def table() -> Table:
    """The one table this module owns."""
    return Notice.__table__


def create_table(bind: Any) -> None:
    """Create the table on a synchronous connection or engine, if absent."""
    table().create(bind, checkfirst=True)


def drop_table(bind: Any) -> None:
    """Drop the table on a synchronous connection or engine, if present.

    Only the uninstall path calls this, and only when the operator asked for
    the data to go too. Uninstalling a module leaves its rows alone by default.
    """
    table().drop(bind, checkfirst=True)


async def ensure_table(engine: Any) -> None:
    """Create the table through an async engine. Safe to call repeatedly."""
    async with engine.begin() as connection:
        await connection.run_sync(create_table)


async def remove_table(engine: Any) -> None:
    """Drop the table through an async engine. Destroys the module's data."""
    async with engine.begin() as connection:
        await connection.run_sync(drop_table)
