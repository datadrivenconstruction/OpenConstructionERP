"""Site Notice ORM model.

Table:
    oe_refresh_notice_notice
"""

# Generated by the OpenConstructionERP module builder from a module
# specification. Edits are kept: the builder never overwrites a module it
# did not just create. To change the shape, change the spec and generate
# a new version.

import uuid
from datetime import datetime

from sqlalchemy import DateTime, Index, String, func
from sqlalchemy.orm import Mapped, mapped_column

from app.database import GUID, Base


class Notice(Base):
    """Notice."""

    __tablename__ = 'oe_refresh_notice_notice'

    id: Mapped[uuid.UUID] = mapped_column(GUID(), primary_key=True, default=uuid.uuid4)
    title: Mapped[str] = mapped_column(String(255), nullable=False)
    created_at: Mapped[datetime] = mapped_column(
        DateTime(timezone=True), server_default=func.now(), nullable=False
    )
    updated_at: Mapped[datetime] = mapped_column(
        DateTime(timezone=True), server_default=func.now(), onupdate=func.now(), nullable=False
    )

    __table_args__ = (
        Index("ix_oe_refresh_notice_notice_created", "created_at"),
    )
