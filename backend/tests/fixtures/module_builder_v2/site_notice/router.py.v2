"""Site Notice HTTP API."""

# Generated by the OpenConstructionERP module builder from a module
# specification. Edits are kept: the builder never overwrites a module it
# did not just create. To change the shape, change the spec and generate
# a new version.
# This file is the exception: when a newer builder fixes the code it
# renders here, it renders it again from spec.json at startup. The copy it
# replaces is kept under _module_builder/backups in the module folder.

import json
import uuid
from pathlib import Path

from fastapi import APIRouter, Depends, HTTPException, Query, status

from app.dependencies import RequirePermission, SessionDep
from app.modules.site_notice.schemas import (
    NoticeCreate,
    NoticeList,
    NoticeRead,
    NoticeUpdate,
)
from app.modules.site_notice.service import NoticeService, ValidationRefused

router = APIRouter()

# These records belong to no project, so there is no narrower scope to check:
# the module permission is the whole access rule, as for any register that is
# shared across the installation. A project-scoped module also checks access to
# the record's project on every route.


@router.get("/ui-spec", summary="The screen description this module renders from")
async def ui_spec() -> dict:
    """Return the module specification.

    The frontend is a compiled bundle, so a module installed at runtime cannot
    ship a screen of its own. It ships this instead, and the platform renders
    the list, the detail and the form from it.
    """
    path = Path(__file__).parent / "spec.json"
    if not path.is_file():
        raise HTTPException(status.HTTP_404_NOT_FOUND, "this module carries no ui spec")
    return json.loads(path.read_text(encoding="utf-8"))


@router.get("", response_model=NoticeList, summary="List notices")
async def list_records(
    db: SessionDep,
    limit: int = Query(100, ge=1, le=500),
    offset: int = Query(0, ge=0),
    _perm: None = Depends(RequirePermission("site_notice.read")),
) -> NoticeList:
    rows, total = await NoticeService(db).list_page(limit=limit, offset=offset)
    return NoticeList(items=[NoticeRead.model_validate(r) for r in rows], total=total)


@router.get("/{record_id}", response_model=NoticeRead, summary="One notice")
async def get_record(
    record_id: uuid.UUID,
    db: SessionDep,
    _perm: None = Depends(RequirePermission("site_notice.read")),
) -> NoticeRead:
    record = await NoticeService(db).get(record_id)
    if record is None:
        raise HTTPException(status.HTTP_404_NOT_FOUND, "not found")
    return NoticeRead.model_validate(record)


@router.post("", response_model=NoticeRead, status_code=status.HTTP_201_CREATED)
async def create_record(
    payload: NoticeCreate,
    db: SessionDep,
    _perm: None = Depends(RequirePermission("site_notice.write")),
) -> NoticeRead:
    try:
        record, _findings = await NoticeService(db).create(payload)
    except ValidationRefused as exc:
        raise HTTPException(
            status.HTTP_422_UNPROCESSABLE_CONTENT,
            detail=[{"code": f.code, "message": f.message, "field": f.field} for f in exc.findings],
        ) from exc
    await db.commit()
    await db.refresh(record)
    return NoticeRead.model_validate(record)


@router.patch("/{record_id}", response_model=NoticeRead)
async def update_record(
    record_id: uuid.UUID,
    payload: NoticeUpdate,
    db: SessionDep,
    _perm: None = Depends(RequirePermission("site_notice.write")),
) -> NoticeRead:
    service = NoticeService(db)
    record = await service.get(record_id)
    if record is None:
        raise HTTPException(status.HTTP_404_NOT_FOUND, "not found")
    try:
        record, _findings = await service.update(record, payload)
    except ValidationRefused as exc:
        raise HTTPException(
            status.HTTP_422_UNPROCESSABLE_CONTENT,
            detail=[{"code": f.code, "message": f.message, "field": f.field} for f in exc.findings],
        ) from exc
    await db.commit()
    await db.refresh(record)
    return NoticeRead.model_validate(record)


@router.delete("/{record_id}", status_code=status.HTTP_204_NO_CONTENT)
async def delete_record(
    record_id: uuid.UUID,
    db: SessionDep,
    # Deleting is a manager's action, as it is everywhere else in the platform.
    # Whoever may correct a record is not automatically whoever may remove it.
    _perm: None = Depends(RequirePermission("site_notice.delete")),
) -> None:
    service = NoticeService(db)
    record = await service.get(record_id)
    if record is None:
        raise HTTPException(status.HTTP_404_NOT_FOUND, "not found")
    await service.delete(record)
    await db.commit()
