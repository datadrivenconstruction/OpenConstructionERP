"""Site Notice permissions.

Registered rather than merely referenced: a permission the registry has never
heard of is denied to everyone except an administrator, and a test run as an
administrator cannot see the difference.
"""

# Generated by the OpenConstructionERP module builder from a module
# specification. Edits are kept: the builder never overwrites a module it
# did not just create. To change the shape, change the spec and generate
# a new version.

from app.core.permissions import Role, permission_registry

SITE_NOTICE_PERMISSIONS: dict[str, Role] = {
    "site_notice.read": Role.VIEWER,
    "site_notice.write": Role.EDITOR,
    "site_notice.delete": Role.MANAGER,
}


def register_site_notice_permissions() -> None:
    """Register this module's permissions with the platform registry.

    Called from ``on_startup`` in this package's ``__init__``, which is the
    hook the module loader runs once the module is loaded.
    """
    permission_registry.register_module_permissions('site_notice', SITE_NOTICE_PERMISSIONS)
