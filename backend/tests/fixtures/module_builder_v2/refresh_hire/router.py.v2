"""Plant Hire HTTP API."""

# Generated by the OpenConstructionERP module builder from a module
# specification. Edits are kept: the builder never overwrites a module it
# did not just create. To change the shape, change the spec and generate
# a new version.
# This file is the exception: when a newer builder fixes the code it
# renders here, it renders it again from spec.json at startup. The copy it
# replaces is kept under _module_builder/backups in the module folder.

import json
import uuid
from pathlib import Path

from fastapi import APIRouter, Depends, HTTPException, Query, status

from app.dependencies import (
    CurrentUserId,
    RequirePermission,
    SessionDep,
    accessible_project_ids,
    verify_project_access,
)
from app.modules.refresh_hire import models
from app.modules.refresh_hire.schemas import (
    HireCreate,
    HireList,
    HireRead,
    HireUpdate,
)
from app.modules.refresh_hire.service import HireService, ValidationRefused

router = APIRouter()

# Every record belongs to a project, and the module permission says nothing
# about which projects. So each route also applies the platform's project
# access rule (owner, team member or administrator) and answers 404 where it
# refuses: the same answer as for a record that does not exist, so a caller
# cannot learn which ids exist in projects they cannot see.


async def _reachable(service: HireService, record_id: uuid.UUID, user_id: str, db: SessionDep) -> models.Hire:
    """The record, if it exists and the caller may reach its project.

    ``verify_project_access`` refuses with "Project not found", which would
    tell the caller that the record exists. Its 404 is replaced with the one a
    missing record gets, so both refusals read the same.
    """
    record = await service.get(record_id)
    if record is None:
        raise HTTPException(status.HTTP_404_NOT_FOUND, "not found")
    try:
        await verify_project_access(record.project_id, user_id, db)
    except HTTPException as exc:
        if exc.status_code != status.HTTP_404_NOT_FOUND:
            raise
        raise HTTPException(status.HTTP_404_NOT_FOUND, "not found") from None
    return record


@router.get("/ui-spec", summary="The screen description this module renders from")
async def ui_spec() -> dict:
    """Return the module specification.

    The frontend is a compiled bundle, so a module installed at runtime cannot
    ship a screen of its own. It ships this instead, and the platform renders
    the list, the detail and the form from it.
    """
    path = Path(__file__).parent / "spec.json"
    if not path.is_file():
        raise HTTPException(status.HTTP_404_NOT_FOUND, "this module carries no ui spec")
    return json.loads(path.read_text(encoding="utf-8"))


@router.get("", response_model=HireList, summary="List hires")
async def list_records(
    db: SessionDep,
    user_id: CurrentUserId,
    project_id: uuid.UUID | None = Query(None, description="Restrict to one project"),
    limit: int = Query(100, ge=1, le=500),
    offset: int = Query(0, ge=0),
    _perm: None = Depends(RequirePermission("refresh_hire.read")),
) -> HireList:
    within = None
    if project_id is not None:
        await verify_project_access(project_id, user_id, db)
    else:
        # The projects this caller may reach. None for an administrator, who is
        # not restricted; an empty set for someone with no projects, which
        # lists nothing rather than everything.
        within = await accessible_project_ids(db, user_id)
    rows, total = await HireService(db).list_page(
        project_id=project_id, within=within, limit=limit, offset=offset
    )
    return HireList(items=[HireRead.model_validate(r) for r in rows], total=total)


@router.get("/{record_id}", response_model=HireRead, summary="One hire")
async def get_record(
    record_id: uuid.UUID,
    db: SessionDep,
    user_id: CurrentUserId,
    _perm: None = Depends(RequirePermission("refresh_hire.read")),
) -> HireRead:
    record = await _reachable(HireService(db), record_id, user_id, db)
    return HireRead.model_validate(record)


@router.post("", response_model=HireRead, status_code=status.HTTP_201_CREATED)
async def create_record(
    payload: HireCreate,
    db: SessionDep,
    user_id: CurrentUserId,
    _perm: None = Depends(RequirePermission("refresh_hire.write")),
) -> HireRead:
    # The project in the body is the caller's claim, not a fact. A project
    # they cannot reach answers 404, exactly as one that does not exist.
    await verify_project_access(payload.project_id, user_id, db)
    try:
        record, _findings = await HireService(db).create(payload)
    except ValidationRefused as exc:
        raise HTTPException(
            status.HTTP_422_UNPROCESSABLE_CONTENT,
            detail=[{"code": f.code, "message": f.message, "field": f.field} for f in exc.findings],
        ) from exc
    await db.commit()
    await db.refresh(record)
    return HireRead.model_validate(record)


@router.patch("/{record_id}", response_model=HireRead)
async def update_record(
    record_id: uuid.UUID,
    payload: HireUpdate,
    db: SessionDep,
    user_id: CurrentUserId,
    _perm: None = Depends(RequirePermission("refresh_hire.write")),
) -> HireRead:
    service = HireService(db)
    # Before validation, so a refused record answers 404 and never a 422
    # that would confirm it exists. The update schema has no project_id,
    # so a record cannot be moved into a project from here.
    record = await _reachable(service, record_id, user_id, db)
    try:
        record, _findings = await service.update(record, payload)
    except ValidationRefused as exc:
        raise HTTPException(
            status.HTTP_422_UNPROCESSABLE_CONTENT,
            detail=[{"code": f.code, "message": f.message, "field": f.field} for f in exc.findings],
        ) from exc
    await db.commit()
    await db.refresh(record)
    return HireRead.model_validate(record)


@router.delete("/{record_id}", status_code=status.HTTP_204_NO_CONTENT)
async def delete_record(
    record_id: uuid.UUID,
    db: SessionDep,
    user_id: CurrentUserId,
    # Deleting is a manager's action, as it is everywhere else in the platform.
    # Whoever may correct a record is not automatically whoever may remove it.
    _perm: None = Depends(RequirePermission("refresh_hire.delete")),
) -> None:
    service = HireService(db)
    record = await _reachable(service, record_id, user_id, db)
    await service.delete(record)
    await db.commit()
