"""Plant Hire business logic."""

# Generated by the OpenConstructionERP module builder from a module
# specification. Edits are kept: the builder never overwrites a module it
# did not just create. To change the shape, change the spec and generate
# a new version.
# This file is the exception: when a newer builder fixes the code it
# renders here, it renders it again from spec.json at startup. The copy it
# replaces is kept under _module_builder/backups in the module folder.

import uuid
from collections.abc import Collection

from sqlalchemy.ext.asyncio import AsyncSession

from app.modules.refresh_hire.models import Hire
from app.modules.refresh_hire.repository import HireRepository
from app.modules.refresh_hire.schemas import HireCreate, HireUpdate
from app.modules.refresh_hire.validators import Finding, blocking, validate


class ValidationRefused(Exception):
    """A write that the module's own rules will not allow."""

    def __init__(self, findings: list[Finding]) -> None:
        self.findings = findings
        super().__init__("; ".join(f"{f.code}: {f.message}" for f in findings))


class HireService:
    """The operations the router exposes, with validation attached to writes."""

    def __init__(self, session: AsyncSession) -> None:
        self.repo = HireRepository(session)

    async def list_page(
        self,
        project_id: uuid.UUID | None = None,
        within: Collection[uuid.UUID] | None = None,
        limit: int = 100,
        offset: int = 0,
    ) -> tuple[list[Hire], int]:
        return await self.repo.list_page(project_id=project_id, within=within, limit=limit, offset=offset)

    async def get(self, record_id: uuid.UUID) -> Hire | None:
        return await self.repo.get(record_id)

    async def create(self, payload: HireCreate) -> tuple[Hire, list[Finding]]:
        findings = validate(payload)
        if blocking(findings):
            raise ValidationRefused(blocking(findings))
        record = Hire(**payload.model_dump())
        await self.repo.add(record)
        return record, findings

    async def update(
        self, record: Hire, payload: HireUpdate
    ) -> tuple[Hire, list[Finding]]:
        # Validate the record as it will be, not the patch on its own: a rule
        # about two fields cannot be judged from whichever one was sent.
        changes = payload.model_dump(exclude_unset=True)
        merged = _Merged(record, changes)
        findings = validate(merged)
        if blocking(findings):
            raise ValidationRefused(blocking(findings))
        for key, value in changes.items():
            setattr(record, key, value)
        return record, findings

    async def delete(self, record: Hire) -> None:
        await self.repo.delete(record)


class _Merged:
    """A read-only view of a record with pending changes applied.

    Used to validate an update before it is written, so a refused update leaves
    the row untouched rather than needing a rollback.
    """

    def __init__(self, record: object, changes: dict[str, object]) -> None:
        self._record = record
        self._changes = changes

    def __getattr__(self, name: str) -> object:
        if name in self._changes:
            return self._changes[name]
        return getattr(self._record, name)
