"""Plant Hire request and response schemas."""

# Generated by the OpenConstructionERP module builder from a module
# specification. Edits are kept: the builder never overwrites a module it
# did not just create. To change the shape, change the spec and generate
# a new version.

import uuid
from datetime import date, datetime  # noqa: F401
from decimal import Decimal  # noqa: F401

from pydantic import BaseModel, ConfigDict


class HireCreate(BaseModel):
    """Payload for creating one hire."""

    model_config = ConfigDict(extra="forbid")

    project_id: uuid.UUID
    reference: str
    weekly_rate: Decimal
    on_hire_date: date | None = None


class HireUpdate(BaseModel):
    """Partial update. Every field is optional; absent means unchanged."""

    model_config = ConfigDict(extra="forbid")

    reference: str | None = None
    weekly_rate: Decimal | None = None
    on_hire_date: date | None = None


class HireRead(BaseModel):
    """One hire as the API returns it."""

    model_config = ConfigDict(from_attributes=True)

    id: uuid.UUID
    project_id: uuid.UUID
    reference: str
    weekly_rate: Decimal
    on_hire_date: date | None
    created_at: datetime
    updated_at: datetime


class HireList(BaseModel):
    """A page of hires."""

    items: list[HireRead]
    total: int
