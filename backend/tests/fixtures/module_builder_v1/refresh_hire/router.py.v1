"""Plant Hire HTTP API."""

# Generated by the OpenConstructionERP module builder from a module
# specification. Edits are kept: the builder never overwrites a module it
# did not just create. To change the shape, change the spec and generate
# a new version.

import json
import uuid
from pathlib import Path

from fastapi import APIRouter, Depends, HTTPException, Query, status

from app.dependencies import RequirePermission, SessionDep
from app.modules.refresh_hire.schemas import (
    HireCreate,
    HireList,
    HireRead,
    HireUpdate,
)
from app.modules.refresh_hire.service import HireService, ValidationRefused

router = APIRouter()


@router.get("/ui-spec", summary="The screen description this module renders from")
async def ui_spec() -> dict:
    """Return the module specification.

    The frontend is a compiled bundle, so a module installed at runtime cannot
    ship a screen of its own. It ships this instead, and the platform renders
    the list, the detail and the form from it.
    """
    path = Path(__file__).parent / "spec.json"
    if not path.is_file():
        raise HTTPException(status.HTTP_404_NOT_FOUND, "this module carries no ui spec")
    return json.loads(path.read_text(encoding="utf-8"))


@router.get("", response_model=HireList, summary="List hires")
async def list_records(
    db: SessionDep,
    project_id: uuid.UUID | None = Query(None, description="Restrict to one project"),
    limit: int = Query(100, ge=1, le=500),
    offset: int = Query(0, ge=0),
    _perm: None = Depends(RequirePermission("refresh_hire.read")),
) -> HireList:
    rows, total = await HireService(db).list_page(project_id=project_id, limit=limit, offset=offset)
    return HireList(items=[HireRead.model_validate(r) for r in rows], total=total)


@router.get("/{record_id}", response_model=HireRead, summary="One hire")
async def get_record(
    record_id: uuid.UUID,
    db: SessionDep,
    _perm: None = Depends(RequirePermission("refresh_hire.read")),
) -> HireRead:
    record = await HireService(db).get(record_id)
    if record is None:
        raise HTTPException(status.HTTP_404_NOT_FOUND, "not found")
    return HireRead.model_validate(record)


@router.post("", response_model=HireRead, status_code=status.HTTP_201_CREATED)
async def create_record(
    payload: HireCreate,
    db: SessionDep,
    _perm: None = Depends(RequirePermission("refresh_hire.write")),
) -> HireRead:
    try:
        record, _findings = await HireService(db).create(payload)
    except ValidationRefused as exc:
        raise HTTPException(
            status.HTTP_422_UNPROCESSABLE_CONTENT,
            detail=[{"code": f.code, "message": f.message, "field": f.field} for f in exc.findings],
        ) from exc
    await db.commit()
    await db.refresh(record)
    return HireRead.model_validate(record)


@router.patch("/{record_id}", response_model=HireRead)
async def update_record(
    record_id: uuid.UUID,
    payload: HireUpdate,
    db: SessionDep,
    _perm: None = Depends(RequirePermission("refresh_hire.write")),
) -> HireRead:
    service = HireService(db)
    record = await service.get(record_id)
    if record is None:
        raise HTTPException(status.HTTP_404_NOT_FOUND, "not found")
    try:
        record, _findings = await service.update(record, payload)
    except ValidationRefused as exc:
        raise HTTPException(
            status.HTTP_422_UNPROCESSABLE_CONTENT,
            detail=[{"code": f.code, "message": f.message, "field": f.field} for f in exc.findings],
        ) from exc
    await db.commit()
    await db.refresh(record)
    return HireRead.model_validate(record)


@router.delete("/{record_id}", status_code=status.HTTP_204_NO_CONTENT)
async def delete_record(
    record_id: uuid.UUID,
    db: SessionDep,
    # Deleting is a manager's action, as it is everywhere else in the platform.
    # Whoever may correct a record is not automatically whoever may remove it.
    _perm: None = Depends(RequirePermission("refresh_hire.delete")),
) -> None:
    service = HireService(db)
    record = await service.get(record_id)
    if record is None:
        raise HTTPException(status.HTTP_404_NOT_FOUND, "not found")
    await service.delete(record)
    await db.commit()
