"""Plant Hire validation rules.

Validation is part of the workflow rather than an option, so these run on
every write and their findings travel with the response.
"""

# Generated by the OpenConstructionERP module builder from a module
# specification. Edits are kept: the builder never overwrites a module it
# did not just create. To change the shape, change the spec and generate
# a new version.

from dataclasses import dataclass
from datetime import date, datetime
from typing import Any


@dataclass(frozen=True)
class Finding:
    """One rule that did not hold."""

    code: str
    message: str
    field: str
    severity: str = "error"


def _is_future(value: Any) -> bool:
    """Whether a date or datetime is after now, comparing like with like."""
    if isinstance(value, datetime):
        from datetime import UTC

        now = datetime.now(UTC)
        # A naive datetime cannot be compared with an aware one, and which of
        # the two arrives depends on the client rather than on this module.
        if value.tzinfo is None:
            value = value.replace(tzinfo=UTC)
        return value > now
    if isinstance(value, date):
        from datetime import UTC

        return value > datetime.now(UTC).date()
    return False


def validate(value: Any) -> list[Finding]:
    """Run every rule. Returns findings; an empty list means the record is sound."""
    findings: list[Finding] = []
    if value.weekly_rate is not None and value.weekly_rate <= 0:
        findings.append(
            Finding(
                code='RATE_POSITIVE',
                message='A weekly rate must be above zero.',
                field='weekly_rate',
                severity='error',
            )
        )
    return findings


def blocking(findings: list[Finding]) -> list[Finding]:
    """The findings that must stop a write, as opposed to warn about it."""
    return [f for f in findings if f.severity == "error"]
