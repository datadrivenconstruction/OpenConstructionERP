{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "ddc-web-release/1",
  "title": "Feed of the latest browser editor release (erp-link/release/latest-web.json)",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "version", "tag", "bridge", "zip", "signature_url", "published_at"],
  "properties": {
    "schema": { "const": "ddc-web-release/1" },
    "version": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+(-[0-9A-Za-z.]+)?$" },
    "tag": { "type": "string", "pattern": "^v[0-9]+\\.[0-9]+\\.[0-9]+(-[0-9A-Za-z.]+)?$" },
    "bridge": { "type": "array", "minItems": 1, "items": { "type": "integer", "minimum": 1 } },
    "zip": {
      "type": "object",
      "additionalProperties": false,
      "required": ["url", "bytes", "sha256"],
      "properties": {
        "url": { "type": "string", "pattern": "^https://" },
        "bytes": { "type": "integer", "minimum": 1 },
        "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
      }
    },
    "signature_url": { "type": "string", "pattern": "^https://.*\\.minisig$" },
    "published_at": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9:]{8}Z$" }
  }
}
