{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://openconstructiondesign.org/schemas/ddc-exchange/1",
  "title": "ddc-exchange/1 — link exchange request and response",
  "description": "POST /link/exchange. The request is `request`, the 200 body is `response`; 410 for a used or expired code, 429 when throttled.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "request",
    "response"
  ],
  "properties": {
    "request": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "code"
      ],
      "properties": {
        "code": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_-]{32,128}$"
        },
        "client": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "name": {
              "type": "string",
              "maxLength": 100
            },
            "version": {
              "type": "string",
              "maxLength": 40
            },
            "os": {
              "type": "string",
              "maxLength": 40
            }
          }
        }
      }
    },
    "response": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "token",
        "expires_at",
        "project_id"
      ],
      "properties": {
        "token": {
          "type": "string",
          "pattern": "^ddcl_[A-Za-z0-9_-]{32,}$"
        },
        "expires_at": {
          "type": "string",
          "format": "date-time"
        },
        "project_id": {
          "$ref": "#/$defs/uuid"
        }
      }
    }
  },
  "$defs": {
    "uuid": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
    }
  }
}
