{
  "_comment": "Tax identifier schemes a legal entity carries, per country of registration. Read by app/modules/legal_entities/tax_ids.py. A pattern is matched against the value uppercased with spaces removed; a mismatch is a warning (entity.tax_id_format), never a refusal. mandatory_on_invoice marks the identifiers the country's invoice rules require of the seller (EU: Directive 2006/112/EC art. 226(3)). A country not listed gets one free 'other' field and no check. Formats only; no checksum is verified.",
  "schema": "oe.entity_tax_ids/1",
  "read_date": "2026-11-16",
  "countries": {
    "AT": {
      "schemes": [
        {
          "scheme": "vat",
          "pattern": "^ATU\\d{8}$",
          "example": "ATU12345678",
          "mandatory_on_invoice": true,
          "legal_reference": "Council Directive 2006/112/EC, art. 226(3)",
          "source_url": "https://ec.europa.eu/taxation_customs/vies/#/faq"
        }
      ]
    },
    "BE": {
      "schemes": [
        {
          "scheme": "vat",
