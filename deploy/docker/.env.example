# OpenEstimate — Production Environment Variables
# Copy this file to .env and modify as needed.

# ── Application ──────────────────────────────────────────────────────
APP_ENV=production
APP_DEBUG=false
LOG_LEVEL=INFO

# ── Database (PostgreSQL for production) ─────────────────────────────
DATABASE_URL=postgresql+asyncpg://oe:CHANGE_ME@localhost:5432/openestimate
DATABASE_SYNC_URL=postgresql://oe:CHANGE_ME@localhost:5432/openestimate
# DATABASE_POOL_SIZE=20
# DATABASE_MAX_OVERFLOW=10

# ── Auth (CHANGE THESE!) ────────────────────────────────────────────
# Commented out rather than given a placeholder, because no compose file we
# ship interpolates from this file: docker-compose.prod.yml and
# docker-compose.quickstart.yml both read the repo-root .env, and the stack
# described in this directory's README is one you assemble yourself with
# `docker run --env-file` or a compose file of your own.
#
# The value that was here, CHANGE_ME_TO_A_RANDOM_64_CHAR_STRING, is 36
# characters and is not on the weak-secret denylist, so it cleared both of
# the backend's checks and would have booted in production carrying a string
# printed in a public repository. A placeholder that passes the check is
# worse than one that fails it, because the failing one refuses to start and
# says why.
#
# Every way of leaving this unset now ends in a refusal that names itself.
# Absent, the backend falls back to the bundled dev key, which IS on the
# denylist and is rejected outside development. Supplied empty by a compose
# that interpolates ${JWT_SECRET} with no value, it is rejected for length.
# Generate a real one with `openssl rand -hex 32`.
# JWT_SECRET=
# JWT_EXPIRE_MINUTES=60
# JWT_REFRESH_EXPIRE_DAYS=30

# ── CORS ─────────────────────────────────────────────────────────────
ALLOWED_ORIGINS=https://your-domain.com

# ── Frontend Serving ─────────────────────────────────────────────────
# Set to true if backend should serve the React frontend directly.
# Set to false if using a separate Nginx/CDN for the frontend.
SERVE_FRONTEND=true

# ── Redis (optional — enables background tasks) ─────────────────────
# REDIS_URL=redis://localhost:6379/0

# ── Storage (S3/MinIO — optional, defaults to local filesystem) ─────
# S3_ENDPOINT=http://localhost:9000
# S3_ACCESS_KEY=minioadmin
# S3_SECRET_KEY=minioadmin
# S3_BUCKET=openestimate

# ── Vector Search ────────────────────────────────────────────────────
# Default: lancedb (embedded, no external service needed)
VECTOR_BACKEND=lancedb
# VECTOR_DATA_DIR=/data/vectors
#
# For Qdrant (production, requires separate Qdrant service):
# VECTOR_BACKEND=qdrant
# QDRANT_URL=http://localhost:6333

# ── Rate Limiting (requests per minute) ──────────────────────────────
# API_RATE_LIMIT=100
# LOGIN_RATE_LIMIT=10
# AI_RATE_LIMIT=10

# ── AI Providers (optional — features degrade gracefully) ────────────
# OPENAI_API_KEY=sk-...
# ANTHROPIC_API_KEY=sk-ant-...

# ── Geocoding (asked once, then contacts the chosen service) ─────────
# Setting a project address resolves it to coordinates automatically.
# Nothing is sent until a manager answers a one-time question in the app:
# send to the public OpenStreetMap services, do not send, or use your own
# mirror. It can be changed later on the Geo Hub admin page (/geo/admin).
# The variables below
# take precedence over that answer.
# Address autocomplete goes to Photon first, then falls back to Nominatim.
# With your own Nominatim (OE_GEOCODER_BASE_URL) Photon is used only when
# OE_GEOCODER_PHOTON_URL names your own Photon too.
#
# Turn all outbound geocoding off (address resolve and autocomplete both):
# OE_GEOCODER_DISABLED=true
#
# Or keep it and point at your own mirrors instead of the public services:
# OE_GEOCODER_BASE_URL=https://nominatim.your-domain.com
# OE_GEOCODER_PHOTON_URL=https://photon.your-domain.com
#
# Use Nominatim only, skipping Photon:
# OE_GEOCODER_PHOTON_DISABLED=true
#
# Contact string in the User-Agent sent to Nominatim, whose usage policy
# requires one. Defaults to the project email; set your own when you run
# your own deployment.
# OE_GEOCODER_USER_AGENT_CONTACT=ops@your-domain.com
